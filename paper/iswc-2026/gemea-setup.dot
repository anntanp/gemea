digraph gemea {
    rankdir=LR;
    newrank=true;
    graph [fontname="Helvetica", fontsize=9, compound=true, nodesep=0.3, ranksep=0.6, splines=curved];
    node  [fontname="Helvetica", fontsize=8, shape=box, style="filled,rounded", fillcolor="#d0d0f0", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=7, arrowsize=0.7];

    subgraph cluster_SH {
        label="Self-Hosted*";
        style=filled;
        fillcolor="#ffffcc";
        color="#aaaaaa";
        fontname="Helvetica";
        fontsize=9;

        USH    [label="User",                  shape=ellipse, fillcolor="#d0d0f0"];
        OW     [label="OpenWebUI"];
        OL     [label="Ollama"];
        MCPO   [label="MCPO"];
        TSH    [label="sparql_query\nPython tool"];

        USH  -> OW   [label="chat"];
        OW   -> OL   [label="inference"];
        OL   -> OW   [label="open-source LLM"];
        OW   -> MCPO [label="tool call"];
        MCPO -> TSH  [label="MCP"];
    }

    subgraph cluster_VPS {
        label="VPS (gemea.ise.fiz-karlsruhe.de)";
        style=filled;
        fillcolor="#ffffcc";
        color="#aaaaaa";
        fontname="Helvetica";
        fontsize=9;

        SHMARQL [label="SHMARQL\nLinked Data browser"];
        QL      [label="QLever\nSPARQL endpoint"];

        SHMARQL -> QL [label="SPARQL proxy"];
    }

    subgraph cluster_CC {
        label="Commercial*";
        style=filled;
        fillcolor="#ffffcc";
        color="#aaaaaa";
        fontname="Helvetica";
        fontsize=9;

        UCC [label="User",  shape=ellipse, fillcolor="#d0d0f0"];
        CL  [label="Claude"];
        TCC [label="sparql_query\nPython tool"];

        UCC -> CL  [label="chat"];
        CL  -> TCC [label="MCP"];
    }

    // cross-cluster edges
    USH -> SHMARQL [label="browse", lhead=cluster_VPS];
    TSH -> QL      [label="SPARQL GET"];
    QL  -> TSH     [label="JSON results", style=dashed];
    TCC -> QL      [label="SPARQL GET"];
    QL  -> TCC     [label="JSON results", style=dashed];
}
